%% ru/08.html - путь запроса через API-сервер
flowchart TD
    REQ["запрос с удостоверением<br/>сертификат, токен, OIDC"] --> AUTHN["аутентификация<br/>кто вы и в каких группах"]
    AUTHN --> AUTHZ["авторизация: RBAC<br/>можно ли вам это действие"]
    AUTHZ --> ADM["контроль допуска<br/>изменяющий, затем проверяющий"]
    ADM --> ETCD["запись в etcd"]
    AUTHN -. "отказ" .-> DENY["запрос не дошёл"]
    AUTHZ -. "отказ" .-> DENY
    ADM -. "отказ" .-> DENY
